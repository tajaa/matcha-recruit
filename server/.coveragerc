# Coverage config for the server suite.
#
# Deliberately a .coveragerc rather than a [tool.coverage] block in a new
# pyproject.toml: adding a pyproject.toml to server/ would move pytest's
# rootdir inference and give pip a project file to interpret, neither of which
# this change needs.

[run]
source = app
branch = true
omit =
    */tests/*
    */__pycache__/*
    venv/*
    */alembic/versions/*
    # Generated / vendored data tables, not logic.
    app/matcha/services/insurance/bls_injury_rates_2024.py

[report]
skip_covered = true
show_missing = true
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:
    # ANCHORED on purpose. `exclude_lines` patterns are re.search'd against the
    # line, so a bare `\.\.\.` matches any line CONTAINING an ellipsis — 1,905
    # of them in app/, every `Field(...)`/`Query(...)`/`File(...)` included. Worse,
    # 49 of those are `def` lines, and excluding a def excludes its whole body.
    # That inflates the baseline and hands free credit to the diff-coverage gate.
    ^\s*\.\.\.\s*$

[xml]
output = coverage.xml
