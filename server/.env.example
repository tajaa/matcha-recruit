# Database
DATABASE_URL=postgresql://user:password@localhost:5432/matcha
# SSL mode for PostgreSQL: disable | require | verify-full
DATABASE_SSL=disable

# Gemini API key
LIVE_API=your-gemini-api-key

# Models
# Leave unset — the defaults live in app/config.py (analysis defaults to the
# current fleet id from core/services/model_catalog.py). Set these only to pin
# a specific model for local experiments; a stale value here silently overrides
# a fleet bump.
# GEMINI_LIVE_MODEL=
# GEMINI_ANALYSIS_MODEL=
GEMINI_VOICE=Kore
GEMINI_HOURLY_LIMIT=50
GEMINI_DAILY_LIMIT=50

# Server
PORT=8000
# Published Cappe tenant base. Production edge cutover uses gummfit.com.
CAPPE_BASE_DOMAIN=gummfit.com
# Storefront shopper sessions keep the normal short access token, with a
# mobile-friendly rotating refresh window (idle / absolute).
CAPPE_SHOPPER_REFRESH_IDLE_DAYS=30
CAPPE_SHOPPER_REFRESH_ABSOLUTE_DAYS=180
# Comma-separated white-label bundle IDs allowed to register for Cappe push.
CAPPE_APNS_BUNDLE_IDS=com.ahnimal.app
# Optional Cappe-specific APNs key. Leave empty to fall back to APNS_*.
CAPPE_APNS_KEY_ID=
CAPPE_APNS_TEAM_ID=
CAPPE_APNS_AUTH_KEY_PATH=

# CloudFront -> nginx origin authentication. Set only on the EC2 backend and
# as an origin custom header after the Cappe distribution is created.
CAPPE_CLOUDFRONT_ORIGIN_SECRET=

# Same, for the matcha origin (hey-matcha.com). Today one distribution injects
# both headers, so either authenticates the single edge hop; if the
# distributions are ever split, leaving this unset makes every matcha per-IP
# rate limit silently key on the CloudFront POP address instead of the viewer.
# See docs/ops/MATCHA_EDGE.md.
MATCHA_CLOUDFRONT_ORIGIN_SECRET=

# ── Cappe money paths ────────────────────────────────────────────────────────
# Signing secret for the Cappe storefront CONNECT webhook (/api/cappe/payments/webhook).
CAPPE_STRIPE_WEBHOOK_SECRET=
# Signing secret for the Cappe PLATFORM webhook (/api/cappe/domains/webhook) —
# domain purchases + subscription billing on our own account. Distinct endpoint,
# distinct secret from the Connect one above.
CAPPE_PLATFORM_WEBHOOK_SECRET=
# Platform fee taken on each storefront sale, in basis points (200 = 2%).
CAPPE_PLATFORM_FEE_BPS=200

# ── Cappe domain reselling (Porkbun) ─────────────────────────────────────────
# API credentials for the ONE funded Porkbun account we register under. Unset ⇒
# search/purchase raise and the buy flow is dark; BYO connect still works.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# Flat markup in USD cents added to Porkbun's wholesale price (800 = +$8/yr).
CAPPE_DOMAIN_MARKUP_CENTS=800

# ── Cappe custom domains at the CloudFront edge ──────────────────────────────
# Master switch. Leave false until the AWS setup in
# docs/ops/CAPPE_CUSTOM_DOMAINS.md is done — search/purchase/connect 503 while off.
CAPPE_CUSTOM_DOMAINS_ENABLED=false
# The tenant-only distribution each custom domain is attached to as a tenant.
CAPPE_CF_TENANT_DISTRIBUTION_ID=
# The connection group those tenants route through.
CAPPE_CF_CONNECTION_GROUP_ID=
# That connection group's RoutingEndpoint (<id>.cloudfront.net) — the host a
# tenant's apex ALIAS/ANAME and www CNAME point at.
CAPPE_CF_ROUTING_ENDPOINT=
# Scoped IAM key allowed ONLY the CloudFront distribution-tenant calls. Unset ⇒
# boto3's default credential chain (which on the app EC2 is the admin key).
CAPPE_CLOUDFRONT_ACCESS_KEY_ID=
CAPPE_CLOUDFRONT_SECRET_ACCESS_KEY=

# App base URL used for OAuth callback redirects
APP_BASE_URL=http://localhost:5173

# Google Sign-In (Continue with Google) — audience allowlist for ID-token
# verification. Unset ⇒ every Google sign-in attempt is rejected (fail-closed).
# iOS OAuth clients are public (no secret), safe to set here and in project.yml.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# OSHA ITA (Injury Tracking Application) electronic 300A filing.
# Optional — defaults to the production API base when unset.
# Set to the sandbox to test filing end-to-end without a real submission
# (sandbox data is purged periodically and does NOT satisfy a filing obligation):
#   OSHA_ITA_API_URL=https://preview.osha.gov/oshaApi/v1
# Per-company ITA API tokens are supplied by each employer in-app (encrypted at
# rest); there is no platform-level OSHA credential.
# OSHA_ITA_API_URL=https://www.osha.gov/oshaApi/v1

# Oceanlab (music catalog) — static bearer token
OCEANLAB_TOKEN=change-me
