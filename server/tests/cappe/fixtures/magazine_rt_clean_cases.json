       "type": "text",
       "text": "b",
       "marks": [
        {
         "type": "bold"
        },
        {
         "type": "italic"
        }
       ]
      },
      {
       "type": "text",
       "text": "c",
       "marks": [
        {
         "type": "link",
         "attrs": {
          "href": "javascript:alert(1)"
