# Build from repository root. BACKEND_IMAGE must be the digest for this release;
# this image is deployed ONLY on the separate media host.
ARG BACKEND_IMAGE
FROM node:22-bookworm-slim AS scenes
WORKDIR /client
COPY client/package.json client/package-lock.json ./
# --legacy-peer-deps as client/Dockerfile and ci.yml: this lockfile carries
# react<=18 peer ranges under React 19 and plain `npm ci` stops on ERESOLVE.
RUN npm ci --legacy-peer-deps
# Only what the scene bundle builds from. `COPY client/` would also bring a
# checkout's client/node_modules (the root .dockerignore matches only a
# top-level one) and its host-built rollup/esbuild binaries over Linux's.
COPY client/vite.recap.config.ts client/tsconfig*.json ./
COPY client/src/work/types.ts ./src/work/types.ts
COPY client/src/work/recaps ./src/work/recaps
RUN npm run build:recaps

FROM ${BACKEND_IMAGE} AS media
USER root
RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
COPY --from=scenes --chown=matcha:matcha /client/dist-recap /app/recap-render
COPY --chown=matcha:matcha server/app /app/app
USER matcha
ENV ESPRESSO_RECAPS_WORKER=1
HEALTHCHECK NONE
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--pool=solo", "-Q", "espresso_recaps_render", "--concurrency=1", "--loglevel=info"]
