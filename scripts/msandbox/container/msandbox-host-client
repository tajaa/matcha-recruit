#!/usr/bin/env python3
"""Submit one allowlisted host action through the per-session bridge."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import tempfile
import time
import uuid
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(prog="msandbox-host")
    subcommands = parser.add_subparsers(dest="command", required=True)
    xcode = subcommands.add_parser("xcode")
    xcode.add_argument("target", choices=("espresso", "matchatutor", "tellus", "gummfit"))
    xcode.add_argument("action", choices=("build", "test"))
    xcode.add_argument("--timeout", type=int, default=1800)
    args = parser.parse_args()

    bridge = Path(os.environ.get("MSANDBOX_BRIDGE_DIR", "/msandbox-bridge"))
    requests = bridge / "requests"
    results = bridge / "results"
    requests.mkdir(parents=True, exist_ok=True)
    results.mkdir(parents=True, exist_ok=True)
    request_id = uuid.uuid4().hex
    request = {
        "schema_version": 1,
        "type": "xcode",
        "session_id": os.environ["MSANDBOX_SESSION_ID"],
        "commit_sha": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
        "target": args.target,
        "action": args.action,
    }
    fd, temporary_name = tempfile.mkstemp(prefix=".request.", dir=requests)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(request, handle)
        handle.write("\n")
    os.replace(temporary_name, requests / f"{request_id}.json")
    result_path = results / f"{request_id}.json"
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        if result_path.is_file():
            result = json.loads(result_path.read_text(encoding="utf-8"))
            print(json.dumps(result, indent=2))
            result_path.unlink()
            return 0 if result.get("status") == "pass" else 1
        time.sleep(0.25)
    print(f"host action timed out after {args.timeout}s", file=__import__("sys").stderr)
    return 124


if __name__ == "__main__":
    raise SystemExit(main())
