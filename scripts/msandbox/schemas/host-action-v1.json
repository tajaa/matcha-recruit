{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matcha.local/schemas/msandbox/host-action-v1.json",
  "title": "Matcha msandbox host action",
  "type": "object",
  "required": ["schema_version", "type", "session_id", "commit_sha", "target", "action"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"const": "xcode"},
    "session_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target": {"enum": ["espresso", "matchatutor", "tellus", "gummfit"]},
    "action": {"enum": ["build", "test"]}
  },
  "additionalProperties": false
}
