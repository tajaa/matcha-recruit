{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MatchaWriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:us-west-1:010438494410:log-group:/matcha/*"
    }
  ]
}
