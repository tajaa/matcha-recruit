{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/matcha/nginx-access",
            "log_stream_name": "{hostname}",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/matcha/nginx-error",
            "log_stream_name": "{hostname}",
            "retention_in_days": 90
          }
        ]
      }
    }
  }
}
