# CloudFront-only origin gate for the canonical Gummfit server blocks.
#
# Install the real file at:
#   /etc/nginx/snippets/cappe-cloudfront-origin-gate.conf
#
# Replace the placeholder with a secret stored only on the EC2 host. CloudFront
# must overwrite X-Cappe-Origin-Verify with the same value as an origin custom
# header; never accept this header from viewers.
if ($http_x_cappe_origin_verify != "REPLACE_WITH_EC2_SECRET") {
    return 403;
}
