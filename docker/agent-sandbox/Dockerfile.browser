ARG SANDBOX_BASE_IMAGE=python:3.12-slim-bookworm
FROM ${SANDBOX_BASE_IMAGE}

# Browser sessions are an additive layer over the exact content-addressed
# non-browser workspace image. Rebuilding every agent CLI and dependency tree
# merely because Chromium is requested costs gigabytes of writes and can take
# tens of minutes on a slow registry connection.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libdrm2 \
        libgbm1 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        xdg-utils \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb

RUN PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.playwright.dev \
    PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=600000 \
    /opt/bootstrap/server-venv/bin/python -m playwright install --only-shell chromium
