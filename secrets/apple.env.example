# Copy to secrets/apple.env (untracked) and fill in. Loaded by platforms/apple-env.sh.
# App Store Connect → Users and Access → Integrations → Team Keys (Issuer ID is the UUID at the top).
APPLE_API_ISSUER_ID=

# Optional — default to the single secrets/AuthKey_<ID>.p8 and its <ID>:
# APPLE_API_KEY_ID=
# APPLE_API_KEY_PATH=
